+bool DeviceLock::changeUnlockPassword() {
+  if (!openConfigurationRecord())
+    return false;
+
+  if (!promptForCurrentSecret("Current unlock password", unlock_hash)) {
+    preferences.end();
+    return false;
+  }
+
+  while (true) {
+    char new_password[INPUT_BUFFER_LENGTH] = {0};
+    char confirmation[INPUT_BUFFER_LENGTH] = {0};
+    uint8_t new_hash[sizeof(unlock_hash)] = {0};
+    uint8_t stored_hash[sizeof(unlock_hash)] = {0};
+
+    if (!keyboardInput(new_password,
+                       sizeof(new_password),
+                       "New unlock password (8+)",
+                       true,
+                       true)) {
+      secureZero(new_password, sizeof(new_password));
+      preferences.end();
+      return false;
+    }
+
+    if (strlen(new_password) < MIN_PASSWORD_LENGTH) {
+      secureZero(new_password, sizeof(new_password));
+      showMessage("PASSWORD TOO SHORT",
+                  "Use at least 8 characters",
+                  "Try again",
+                  TFT_RED);
+      delay(1500);
+      continue;
+    }
+
+    if (!keyboardInput(confirmation,
+                       sizeof(confirmation),
+                       "Confirm new unlock password",
+                       true,
+                       true)) {
+      secureZero(new_password, sizeof(new_password));
+      secureZero(confirmation, sizeof(confirmation));
+      preferences.end();
+      return false;
+    }
+
+    if (strcmp(new_password, confirmation) != 0) {
+      secureZero(new_password, sizeof(new_password));
+      secureZero(confirmation, sizeof(confirmation));
+      showMessage("PASSWORD MISMATCH",
+                  "The two entries differ",
+                  "Try new password again",
+                  TFT_RED);
+      delay(1500);
+      continue;
+    }
+
+    const bool hash_ready = deriveHash(new_password, new_hash);
+    secureZero(new_password, sizeof(new_password));
+    secureZero(confirmation, sizeof(confirmation));
+    if (!hash_ready) {
+      secureZero(new_hash, sizeof(new_hash));
+      preferences.end();
+      showMessage("LOCK ERROR",
+                  "Password hashing failed",
+                  "No changes made",
+                  TFT_RED);
+      delay(1800);
+      return false;
+    }
+
+    if (preferences.getBool(KEY_WIPE_ENABLED, false) &&
+        constantTimeEqual(new_hash, wipe_hash, sizeof(new_hash))) {
+      secureZero(new_hash, sizeof(new_hash));
+      showMessage("PASSWORD MUST DIFFER",
+                  "Choose a different password",
+                  "WIPE PIN is unchanged",
+                  TFT_RED);
+      delay(1800);
+      continue;
+    }
+
+    bool stored =
+      preferences.putBytes(KEY_UNLOCK_HASH,
+                           new_hash,
+                           sizeof(new_hash)) == sizeof(new_hash);
+    stored = stored &&
+             preferences.getBytes(KEY_UNLOCK_HASH,
+                                  stored_hash,
+                                  sizeof(stored_hash)) == sizeof(stored_hash) &&
+             constantTimeEqual(new_hash, stored_hash, sizeof(new_hash));
+    if (stored)
+      memcpy(unlock_hash, new_hash, sizeof(unlock_hash));
+
+    secureZero(new_hash, sizeof(new_hash));
+    secureZero(stored_hash, sizeof(stored_hash));
+    preferences.end();
+
+    showMessage(stored ? "PASSWORD UPDATED" : "LOCK ERROR",
+                stored ? "Unlock password changed" : "Could not save password",
+                stored ? "Previous password is invalid" : "Restart and try again",
+                stored ? TFT_GREEN : TFT_RED);
+    delay(1800);
+    return stored;
+  }
+}
