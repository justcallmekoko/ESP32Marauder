+
+bool SDFileServer::takeLock(TickType_t timeout) const {
+  return this->ensureMutex() && xSemaphoreTake(this->mutex, timeout) == pdTRUE;
+}
+
+void SDFileServer::giveLock() const {
+  if (this->mutex != nullptr)
+    xSemaphoreGive(this->mutex);
+}
