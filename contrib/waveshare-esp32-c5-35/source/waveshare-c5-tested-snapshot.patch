+bool validFileServerHost(const AsyncWebServerRequest* request) {
+  if (request == nullptr)
+    return false;
+  String host = request->host();
+  host.toLowerCase();
+  return host == FILE_SERVER_HOST || host == String(FILE_SERVER_HOST) + ":80";
+}
+
+bool reservedInternal83Name(const String& lower, const char* prefix, const char* extension) {
+  if (lower.length() != 12 || !lower.startsWith(prefix) || lower.charAt(8) != '.' ||
+      lower.substring(9) != extension) {
+    return false;
+  }
+  for (size_t i = 2; i < 8; ++i) {
+    const char c = lower.charAt(i);
+    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+      return false;
+  }
+  return true;
+}
+
+bool parsePageNumber(const String& value, uint32_t& page) {
+  if (value.length() == 0 || value.length() > 6)
+    return false;
+
+  uint32_t parsed = 0;
+  for (size_t i = 0; i < value.length(); ++i) {
+    const char c = value.charAt(i);
+    if (c < '0' || c > '9')
+      return false;
+    parsed = (parsed * 10U) + static_cast<uint32_t>(c - '0');
+    if (parsed > 100000U)
+      return false;
+  }
+  page = parsed;
+  return true;
+}
+}
