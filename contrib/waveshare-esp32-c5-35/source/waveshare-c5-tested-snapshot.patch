+
+// The HTTP listener is shared with EvilPortal. SDFileServer never creates a
+// second listener and never removes handlers owned by another feature.
+extern AsyncWebServer server;
+
+class SDFileServer {
+  public:
+    SDFileServer();
+
+    // Safe to call repeatedly. Call it before a catch-all handler when possible;
+    // start() also calls it as a fallback for a file-server-first boot.
+    void registerRoutes(AsyncWebServer& web_server);
+
+    // Activates the already registered routes and starts the shared listener.
+    // share_root must be an existing absolute directory on the SD card.
+    bool start(const String& share_root = "/");
+    bool stop();
+
+    bool active() const;
+    const String& csrfToken() const;
+    uint16_t activeTransfers() const;
+    bool mutationBusy() const;
+
+    // Keeps TFT updates away from SD activity on boards where both share SPI.
+    // A successful beginDisplayUpdate() must be paired with endDisplayUpdate().
+    bool beginDisplayUpdate() const;
+    void endDisplayUpdate() const;
+
+  private:
+    class DownloadReleaseGuard;
+    class TrackedFileResponse;
+    static constexpr size_t MAX_PATH_LENGTH = 240;
+    static constexpr size_t MAX_SEGMENT_LENGTH = 255;
+    static constexpr size_t MAX_UPLOAD_BYTES = 512U * 1024U * 1024U;
+    static constexpr size_t MAX_MULTIPART_OVERHEAD = 64U * 1024U;
+    static constexpr size_t MAX_BROWSE_HTML = 48U * 1024U;
+    static constexpr size_t MAX_BROWSE_ENTRIES = 32;
+    static constexpr TickType_t LOCK_TIMEOUT = pdMS_TO_TICKS(1500);
+
+    struct UploadState {
+      AsyncWebServerRequest* request = nullptr;
+      File file;
+      String target_path;
+      String temp_path;
+      size_t bytes_written = 0;
+      int error_code = 0;
+      String error_message;
+      bool overwrite = false;
+      bool saw_file = false;
+      bool complete = false;
+    };
+
+    AsyncWebServer* web_server = nullptr;
+    mutable SemaphoreHandle_t mutex = nullptr;
+    volatile bool routes_registered = false;
+    volatile bool mode_active = false;
+    volatile bool mutation_in_progress = false;
+    volatile uint16_t active_transfers = 0;
+    AsyncWebServerRequest* download_request = nullptr;
+
+    String share_root = "/";
+    String csrf_token;
+    UploadState upload;
+
+    bool ensureMutex() const;
+    bool takeLock(TickType_t timeout = LOCK_TIMEOUT) const;
+    void giveLock() const;
+
+    void handleBrowse(AsyncWebServerRequest* request);
+    void handleDownload(AsyncWebServerRequest* request);
+    void handleUploadChunk(
+      AsyncWebServerRequest* request,
+      const String& filename,
+      size_t index,
+      uint8_t* data,
+      size_t len,
+      bool final);
+    void handleUploadRequest(AsyncWebServerRequest* request);
+    void handleDelete(AsyncWebServerRequest* request);
+    void handleDisconnect(AsyncWebServerRequest* request);
+    void handleDownloadComplete(AsyncWebServerRequest* request);
+
+    bool authorizedLocked(const AsyncWebServerRequest* request) const;
+    static bool constantTimeEqual(const String& left, const String& right);
+    static bool canonicalizePath(const String& raw, bool allow_root, String& canonical);
+    bool pathInsideShareLocked(const String& canonical) const;
+    static String parentPath(const String& canonical);
+    static String baseName(const String& canonical);
+    static bool reservedSegment(const String& segment);
+    static String htmlEscape(const String& input);
+    static String urlEncode(const String& input);
+    static String randomHex(size_t byte_count);
+
+    bool createInternalPathLocked(
+      const String& parent,
+      const char* prefix,
+      const char* suffix,
+      String& path) const;
+    void failUploadLocked(int code, const String& message);
+    void clearUploadLocked(bool remove_temp);
+    void abortUploadLocked();
