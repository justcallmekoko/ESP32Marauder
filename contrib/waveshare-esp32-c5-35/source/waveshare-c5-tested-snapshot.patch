+
+bool SDFileServer::constantTimeEqual(const String& left, const String& right) {
+  const size_t max_length = left.length() > right.length() ? left.length() : right.length();
+  uint8_t different = static_cast<uint8_t>(left.length() ^ right.length());
+  for (size_t i = 0; i < max_length; ++i) {
+    const uint8_t a = i < left.length() ? static_cast<uint8_t>(left.charAt(i)) : 0;
+    const uint8_t b = i < right.length() ? static_cast<uint8_t>(right.charAt(i)) : 0;
+    different |= a ^ b;
+  }
+  return different == 0;
+}
+
+bool SDFileServer::reservedSegment(const String& segment) {
+  String lower = segment;
+  lower.toLowerCase();
+  return lower == RESERVED_METADATA_DIRECTORY ||
+         lower.startsWith(LEGACY_INTERNAL_PREFIX) ||
+         reservedInternal83Name(lower, "mu", "tmp") ||
+         reservedInternal83Name(lower, "mb", "bak");
+}
+
+bool SDFileServer::canonicalizePath(const String& raw, bool allow_root, String& canonical) {
+  canonical = "";
+  if (raw.length() == 0 || raw.length() > MAX_PATH_LENGTH || raw.charAt(0) != '/')
+    return false;
+
+  String path = raw;
+  while (path.length() > 1 && path.endsWith("/"))
+    path.remove(path.length() - 1);
+
+  if (path == "/") {
+    if (!allow_root)
+      return false;
+    canonical = "/";
+    return true;
+  }
+
+  String result;
+  result.reserve(path.length());
+  size_t start = 1;
+  while (start < path.length()) {
+    const int slash = path.indexOf('/', start);
+    const size_t end = slash < 0 ? path.length() : static_cast<size_t>(slash);
+    if (end == start)
+      return false;
+
+    const String segment = path.substring(start, end);
+    if (segment.length() == 0 || segment.length() > MAX_SEGMENT_LENGTH ||
+        segment == "." || segment == ".." || segment.endsWith(".") ||
+        segment.endsWith(" ") || reservedSegment(segment)) {
+      return false;
+    }
+
+    for (size_t i = 0; i < segment.length(); ++i) {
+      const uint8_t c = static_cast<uint8_t>(segment.charAt(i));
+      if (c < 0x20 || c == 0x7f || c == '\\' || c == '"' ||
+          c == ':' || c == '*' || c == '?' || c == '<' || c == '>' || c == '|') {
+        return false;
+      }
+    }
+
+    result += '/';
+    result += segment;
+    if (slash < 0)
+      break;
+    start = end + 1;
+  }
+
+  if (result.length() == 0 || result.length() > MAX_PATH_LENGTH)
+    return false;
+  canonical = result;
+  return true;
+}
+
+bool SDFileServer::pathInsideShareLocked(const String& canonical) const {
+  if (this->share_root == "/")
+    return canonical.startsWith("/");
+  return canonical == this->share_root ||
+         canonical.startsWith(this->share_root + "/");
+}
+
+String SDFileServer::parentPath(const String& canonical) {
+  if (canonical == "/")
+    return "/";
+  const int slash = canonical.lastIndexOf('/');
+  return slash <= 0 ? String("/") : canonical.substring(0, slash);
+}
+
+String SDFileServer::baseName(const String& canonical) {
+  if (canonical == "/")
+    return "/";
+  const int slash = canonical.lastIndexOf('/');
+  return slash < 0 ? canonical : canonical.substring(slash + 1);
+}
+
+String SDFileServer::htmlEscape(const String& input) {
+  String escaped;
+  escaped.reserve(input.length() + 16);
+  for (size_t i = 0; i < input.length(); ++i) {
+    switch (input.charAt(i)) {
+      case '&': escaped += F("&amp;"); break;
+      case '<': escaped += F("&lt;"); break;
+      case '>': escaped += F("&gt;"); break;
+      case '"': escaped += F("&quot;"); break;
+      case '\'': escaped += F("&#39;"); break;
+      default: escaped += input.charAt(i); break;
+    }
+  }
+  return escaped;
+}
+
+String SDFileServer::urlEncode(const String& input) {
+  static const char hex[] = "0123456789ABCDEF";
+  String encoded;
+  encoded.reserve(input.length() * 3);
+  for (size_t i = 0; i < input.length(); ++i) {
+    const uint8_t c = static_cast<uint8_t>(input.charAt(i));
+    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+        (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~') {
+      encoded += static_cast<char>(c);
+    }
+    else {
+      encoded += '%';
+      encoded += hex[(c >> 4) & 0x0f];
+      encoded += hex[c & 0x0f];
+    }
+  }
+  return encoded;
+}
+
+String SDFileServer::randomHex(size_t byte_count) {
+  static const char hex[] = "0123456789abcdef";
+  String result;
+  result.reserve(byte_count * 2);
+  uint32_t random_value = 0;
+  for (size_t i = 0; i < byte_count; ++i) {
+    if ((i & 3U) == 0)
+      random_value = esp_random();
+    const uint8_t value = static_cast<uint8_t>(random_value >> ((i & 3U) * 8U));
+    result += hex[(value >> 4) & 0x0f];
+    result += hex[value & 0x0f];
+  }
+  return result;
+}
+
+bool SDFileServer::authorizedLocked(const AsyncWebServerRequest* request) const {
+  if (!this->mode_active || this->csrf_token.length() != 32 ||
+      !validFileServerHost(request) || !request->hasHeader(CSRF_HEADER)) {
+    return false;
+  }
+  const AsyncWebHeader* header = request->getHeader(CSRF_HEADER);
+  return header != nullptr && constantTimeEqual(header->value(), this->csrf_token);
+}
+
+void SDFileServer::addSecurityHeaders(AsyncWebServerResponse* response, const String& script_nonce) {
+  if (response == nullptr)
+    return;
+  response->addHeader("Cache-Control", "no-store, max-age=0");
+  response->addHeader("Pragma", "no-cache");
+  response->addHeader("X-Content-Type-Options", "nosniff");
+  response->addHeader("X-Frame-Options", "DENY");
+  response->addHeader("Referrer-Policy", "no-referrer");
+  String policy = F("default-src 'none'; style-src 'unsafe-inline'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'");
+  if (script_nonce.length())
+    policy += String(F("; script-src 'nonce-")) + script_nonce + "'";
+  response->addHeader("Content-Security-Policy", policy);
+}
+
+void SDFileServer::sendText(AsyncWebServerRequest* request, int code, const String& message, const String& retry_after) {
+  if (request == nullptr)
+    return;
+  AsyncWebServerResponse* response = request->beginResponse(code, "text/plain; charset=utf-8", message);
+  addSecurityHeaders(response);
+  if (retry_after.length())
+    response->addHeader("Retry-After", retry_after);
+  request->send(response);
+}
+bool SDFileServer::createInternalPathLocked(
+  const String& parent,
+  const char* prefix,
+  const char* suffix,
+  String& path) const {
+  for (uint8_t attempt = 0; attempt < 16; ++attempt) {
+    String candidate = parent == "/" ? String("/") : parent + "/";
+    candidate += prefix;
+    String token = randomHex(3);
+    token.toUpperCase();
+    candidate += token;
+    candidate += suffix;
+    if (candidate.length() <= MAX_PATH_LENGTH && !SD.exists(candidate)) {
+      path = candidate;
+      return true;
+    }
+  }
+  path = "";
+  return false;
+}
+
+void SDFileServer::failUploadLocked(int code, const String& message) {
+  if (this->upload.error_code == 0) {
+    this->upload.error_code = code;
+    this->upload.error_message = message;
+  }
+  if (this->upload.file)
+    this->upload.file.close();
+}
+
+void SDFileServer::clearUploadLocked(bool remove_temp) {
+  if (this->upload.file)
+    this->upload.file.close();
+  if (remove_temp && this->upload.temp_path.length())
+    SD.remove(this->upload.temp_path);
+  this->upload = UploadState();
+  this->mutation_in_progress = false;
+}
+
+void SDFileServer::abortUploadLocked() {
+  this->clearUploadLocked(true);
+}
+
+void SDFileServer::registerRoutes(AsyncWebServer& target_server) {
+  if (this->routes_registered)
+    return;
+
+  this->web_server = &target_server;
+
+  target_server.on("/files/browse", HTTP_GET, [this](AsyncWebServerRequest* request) {
+    this->handleBrowse(request);
+  }).setFilter(ON_AP_FILTER);
+
+  target_server.on("/files/download", HTTP_GET, [this](AsyncWebServerRequest* request) {
+    this->handleDownload(request);
+  }).setFilter(ON_AP_FILTER);
+
+  target_server.on("/files", HTTP_GET, [this](AsyncWebServerRequest* request) {
+    this->handleBrowse(request);
+  }).setFilter(ON_AP_FILTER);
+
+  target_server.on("/files/", HTTP_GET, [this](AsyncWebServerRequest* request) {
+    this->handleBrowse(request);
+  }).setFilter(ON_AP_FILTER);
+
+  target_server.on(
+    "/files/upload",
+    HTTP_POST,
+    [this](AsyncWebServerRequest* request) {
+      this->handleUploadRequest(request);
+    },
+    [this](AsyncWebServerRequest* request,
+           const String& filename,
+           size_t index,
+           uint8_t* data,
+           size_t len,
+           bool final) {
+      this->handleUploadChunk(request, filename, index, data, len, final);
+    }
+  ).setFilter(ON_AP_FILTER);
+
+  target_server.on("/files/delete", HTTP_POST, [this](AsyncWebServerRequest* request) {
+    this->handleDelete(request);
+  }).setFilter(ON_AP_FILTER);
+
+  this->routes_registered = true;
+}
+
+bool SDFileServer::start(const String& requested_share_root) {
+  this->registerRoutes(server);
+  if (!this->takeLock(portMAX_DELAY))
+    return false;
+
+  String canonical_root;
+  // A legacy long-name directory has a separately addressable FAT 8.3 alias.
+  // Refuse to expose the card until the profile store has migrated that
+  // directory to the reserved real-8.3 name checked by reservedSegment().
+  bool valid = sd_obj.supported &&
+               !SD.exists(LEGACY_METADATA_DIRECTORY) &&
+               canonicalizePath(requested_share_root, true, canonical_root);
+  File root;
+  if (valid) {
+    root = SD.open(canonical_root, FILE_READ);
+    valid = root && root.isDirectory();
+  }
+  if (root)
+    root.close();
+
+  if (!valid) {
+    this->giveLock();
+    return false;
+  }
+
+  if (this->download_request != nullptr || this->active_transfers > 0) {
+    this->giveLock();
+    return false;
+  }
+
+  this->abortUploadLocked();
+  this->share_root = canonical_root;
+  this->csrf_token = randomHex(16);
+  this->mode_active = this->csrf_token.length() == 32;
+  const bool ready = this->mode_active;
+  this->giveLock();
+
+  if (ready && this->web_server != nullptr)
+    this->web_server->begin();
+  return ready;
+}
+
+bool SDFileServer::stop() {
+  if (!this->takeLock(portMAX_DELAY))
+    return false;
+
+  // AsyncFileResponse owns the open SD file until its client disconnects.
+  // Refuse teardown while that response can still read from shared SPI.
+  if (this->download_request != nullptr || this->active_transfers > 0) {
+    this->giveLock();
+    return false;
+  }
+
+  this->mode_active = false;
+  this->abortUploadLocked();
+  for (size_t i = 0; i < this->csrf_token.length(); ++i)
+    this->csrf_token.setCharAt(i, '0');
+  this->csrf_token = "";
+  this->giveLock();
+  return true;
+}
+
+void SDFileServer::handleBrowse(AsyncWebServerRequest* request) {
+  if (!validFileServerHost(request)) {
+    sendText(request, 421, F("Use http://192.168.4.1/files/"));
+    return;
+  }
+
+  String requested_path;
+  if (request->hasParam("path"))
+    requested_path = request->getParam("path")->value();
+
+  uint32_t page = 0;
+  if (request->hasParam("page") &&
+      !parsePageNumber(request->getParam("page")->value(), page)) {
+    sendText(request, 400, F("Invalid page"));
+    return;
+  }
+
+  if (!this->takeLock()) {
+    sendText(request, 503, F("SD card busy"), F("1"));
+    return;
+  }
+
+  if (!this->mode_active) {
+    this->giveLock();
+    sendText(request, 404, F("File manager inactive"));
+    return;
+  }
+  if (requested_path.length() == 0)
+    requested_path = this->share_root;
+  if (this->mutation_in_progress) {
+    this->giveLock();
+    sendText(request, 423, F("An SD write is in progress"), F("1"));
+    return;
+  }
+
+  String canonical;
+  if (!canonicalizePath(requested_path, true, canonical)) {
+    this->giveLock();
+    sendText(request, 400, F("Invalid directory path"));
+    return;
+  }
+  if (!this->pathInsideShareLocked(canonical)) {
+    this->giveLock();
+    sendText(request, 403, F("Path is outside the shared directory"));
+    return;
+  }
+
+  File directory = SD.open(canonical, FILE_READ);
+  if (!directory) {
+    this->giveLock();
+    sendText(request, 404, F("Directory not found"));
+    return;
+  }
+  if (!directory.isDirectory()) {
+    directory.close();
+    this->giveLock();
+    sendText(request, 400, F("Path is not a directory"));
+    return;
+  }
+
+  const String token = this->csrf_token;
+  const String script_nonce = randomHex(12);
+  const size_t first_entry = static_cast<size_t>(page) * MAX_BROWSE_ENTRIES;
+  size_t valid_index = 0;
+  size_t rendered = 0;
+  bool has_next = false;
+
+  String rows;
+  rows.reserve(10000);
+  while (true) {
+    File entry = directory.openNextFile();
+    if (!entry)
+      break;
+
+    const String name = baseName(String(entry.name()));
+    String child = canonical == "/" ? String("/") + name : canonical + "/" + name;
+    String child_canonical;
+    const bool valid_entry = name.length() &&
+                             canonicalizePath(child, false, child_canonical) &&
+                             this->pathInsideShareLocked(child_canonical);
+    if (!valid_entry) {
+      entry.close();
+      continue;
+    }
+
+    if (valid_index++ < first_entry) {
+      entry.close();
+      continue;
+    }
+    if (rendered >= MAX_BROWSE_ENTRIES) {
+      has_next = true;
+      entry.close();
+      break;
+    }
+
+    const bool is_directory = entry.isDirectory();
+    const size_t file_size = entry.size();
+    rows += F("<tr><td>");
+    if (is_directory) {
+      rows += F("&#128193; <a href='/files/?path=");
+      rows += urlEncode(child_canonical);
+      rows += F("&amp;page=0'>");
+      rows += htmlEscape(name);
+      rows += F("/</a>");
+    }
+    else {
+      rows += F("&#128196; <a download href='/files/download?path=");
+      rows += urlEncode(child_canonical);
+      rows += F("'>");
+      rows += htmlEscape(name);
+      rows += F("</a>");
+    }
+    rows += F("</td><td>");
+    rows += is_directory ? String(F("directory")) : String(static_cast<uint32_t>(file_size)) + F(" B");
+    rows += F("</td><td>");
+    if (!is_directory) {
+      rows += F("<button type='button' class='delete' data-path='");
