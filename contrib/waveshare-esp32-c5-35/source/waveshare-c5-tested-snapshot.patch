+void SDFileServer::handleDisconnect(AsyncWebServerRequest* request) {
+  if (!this->takeLock(portMAX_DELAY))
+    return;
+
+  if (this->upload.request == request)
+    this->abortUploadLocked();
+
+  this->giveLock();
+}
+
+void SDFileServer::handleDownloadComplete(AsyncWebServerRequest* request) {
+  if (!this->takeLock(portMAX_DELAY))
+    return;
+
+  if (this->download_request == request) {
+    this->download_request = nullptr;
+    if (this->active_transfers > 0)
+      --this->active_transfers;
+  }
+
+  this->giveLock();
+}
+
+void SDFileServer::handleDownload(AsyncWebServerRequest* request) {
+  if (!validFileServerHost(request)) {
+    sendText(request, 421, F("Use http://192.168.4.1/files/"));
+    return;
+  }
+  if (!request->hasParam("path")) {
+    sendText(request, 400, F("Missing file path"));
+    return;
+  }
+
+  if (!this->takeLock()) {
+    sendText(request, 503, F("SD card busy"), F("1"));
+    return;
+  }
+  if (!this->mode_active) {
+    this->giveLock();
+    sendText(request, 404, F("File manager inactive"));
+    return;
+  }
+  if (this->mutation_in_progress || this->active_transfers > 0) {
+    this->giveLock();
+    sendText(request, 423, F("Another SD transfer is active"), F("1"));
+    return;
+  }
+
+  String canonical;
+  if (!canonicalizePath(request->getParam("path")->value(), false, canonical)) {
+    this->giveLock();
+    sendText(request, 400, F("Invalid file path"));
+    return;
+  }
+  if (!this->pathInsideShareLocked(canonical)) {
+    this->giveLock();
+    sendText(request, 403, F("Path is outside the shared directory"));
+    return;
+  }
+
+  File file = SD.open(canonical, FILE_READ);
+  if (!file) {
+    this->giveLock();
+    sendText(request, 404, F("File not found"));
+    return;
+  }
+  if (file.isDirectory()) {
+    file.close();
+    this->giveLock();
+    sendText(request, 400, F("Directories cannot be downloaded"));
+    return;
+  }
+
+  this->download_request = request;
+  ++this->active_transfers;
+  this->giveLock();
+
+  AsyncWebServerResponse* response = new TrackedFileResponse(
+    this, request, file, canonical);
+  if (response == nullptr) {
+    this->handleDownloadComplete(request);
+    sendText(request, 500, F("Could not create download response"));
+    return;
+  }
+  addSecurityHeaders(response);
+  response->addHeader("Connection", "close");
+  request->send(response);
+}
+
+void SDFileServer::handleUploadChunk(
+  AsyncWebServerRequest* request,
+  const String& filename,
+  size_t index,
+  uint8_t* data,
+  size_t len,
+  bool final) {
+  if (!this->takeLock(portMAX_DELAY))
+    return;
+
+  if (index == 0) {
+    if (!this->mode_active || !this->authorizedLocked(request)) {
+      this->giveLock();
+      return;
+    }
+    if (this->upload.request == request && this->upload.saw_file) {
+      this->failUploadLocked(400, F("Only one file may be uploaded per request"));
+      this->giveLock();
+      return;
+    }
+    if (this->mutation_in_progress || this->active_transfers > 0 ||
+        (this->upload.request != nullptr && this->upload.request != request)) {
+      this->giveLock();
+      return;
+    }
+
+    this->upload = UploadState();
+    this->upload.request = request;
+    this->upload.saw_file = true;
+    this->upload.overwrite = request->hasParam("overwrite") &&
+                             request->getParam("overwrite")->value() == "1";
+    this->mutation_in_progress = true;
+    request->onDisconnect([this, request]() {
+      this->handleDisconnect(request);
+    });
+
+    if (request->contentLength() > MAX_UPLOAD_BYTES + MAX_MULTIPART_OVERHEAD) {
+      this->failUploadLocked(413, F("Upload is too large"));
+      this->giveLock();
+      return;
+    }
+    if (!request->hasParam("dir")) {
+      this->failUploadLocked(400, F("Missing target directory"));
+      this->giveLock();
+      return;
+    }
+    if (filename.length() == 0 || filename.length() > MAX_SEGMENT_LENGTH ||
+        filename.indexOf('/') >= 0 || filename.indexOf('\\') >= 0 ||
+        reservedSegment(filename)) {
+      this->failUploadLocked(400, F("Invalid upload filename"));
+      this->giveLock();
+      return;
+    }
+
+    String directory_path;
+    if (!canonicalizePath(request->getParam("dir")->value(), true, directory_path) ||
+        !this->pathInsideShareLocked(directory_path)) {
+      this->failUploadLocked(400, F("Invalid target directory"));
+      this->giveLock();
+      return;
+    }
+
+    File directory = SD.open(directory_path, FILE_READ);
+    const bool is_directory = directory && directory.isDirectory();
+    if (directory)
+      directory.close();
+    if (!is_directory) {
+      this->failUploadLocked(404, F("Target directory not found"));
+      this->giveLock();
+      return;
+    }
+
+    String joined = directory_path == "/" ? String("/") + filename : directory_path + "/" + filename;
+    if (!canonicalizePath(joined, false, this->upload.target_path) ||
+        !this->pathInsideShareLocked(this->upload.target_path)) {
+      this->failUploadLocked(400, F("Invalid target path"));
+      this->giveLock();
+      return;
+    }
+
+    if (SD.exists(this->upload.target_path)) {
+      File existing = SD.open(this->upload.target_path, FILE_READ);
+      if (!existing) {
+        this->failUploadLocked(500, F("Could not inspect the existing path"));
+        this->giveLock();
+        return;
+      }
+      const bool existing_is_directory = existing.isDirectory();
+      existing.close();
+      if (existing_is_directory) {
+        this->failUploadLocked(409, F("A directory already uses that name"));
+        this->giveLock();
+        return;
+      }
+      if (!this->upload.overwrite) {
+        this->failUploadLocked(409, F("File exists; enable Replace and confirm"));
+        this->giveLock();
+        return;
+      }
+    }
+
+    if (!this->createInternalPathLocked(directory_path, "MU", ".TMP", this->upload.temp_path)) {
+      this->failUploadLocked(500, F("Could not reserve a temporary file"));
+      this->giveLock();
+      return;
+    }
+
+    this->upload.file = SD.open(this->upload.temp_path, FILE_WRITE);
+    if (!this->upload.file) {
+      this->failUploadLocked(507, F("Could not create temporary file"));
+      this->giveLock();
+      return;
+    }
+  }
+
+  if (this->upload.request != request || this->upload.error_code != 0) {
+    this->giveLock();
+    return;
+  }
+  if (!this->mode_active) {
+    this->failUploadLocked(503, F("File manager stopped during upload"));
+    this->giveLock();
+    return;
+  }
+  if (index != this->upload.bytes_written ||
+      len > MAX_UPLOAD_BYTES - this->upload.bytes_written) {
+    this->failUploadLocked(400, F("Invalid upload stream"));
+    this->giveLock();
+    return;
+  }
+
+  if (len > 0) {
+    const size_t written = this->upload.file.write(data, len);
+    if (written != len) {
+      this->upload.bytes_written += written;
+      const uint64_t total_bytes = SD.totalBytes();
+      const uint64_t used_bytes = SD.usedBytes();
+      const uint64_t free_bytes = total_bytes > used_bytes ? total_bytes - used_bytes : 0;
+      Serial.print(F("SD upload short write: index="));
+      Serial.print(index);
+      Serial.print(F(" requested="));
+      Serial.print(len);
+      Serial.print(F(" written="));
+      Serial.print(written);
+      Serial.print(F(" freeMiB="));
+      Serial.println(static_cast<uint32_t>(free_bytes / (1024ULL * 1024ULL)));
+      this->failUploadLocked(507, F("SD write failed or card is full"));
+      this->giveLock();
+      return;
+    }
+    this->upload.bytes_written += written;
+  }
+
+  if (final) {
+    this->upload.file.flush();
+    this->upload.file.close();
+
+    File verification = SD.open(this->upload.temp_path, FILE_READ);
+    const bool verified = verification && !verification.isDirectory() &&
+                          verification.size() == this->upload.bytes_written;
+    const size_t verified_size = verification ? verification.size() : 0;
+    if (verification)
+      verification.close();
+
+    if (!verified) {
+      Serial.print(F("SD upload verification failed: expected="));
+      Serial.print(this->upload.bytes_written);
+      Serial.print(F(" actual="));
+      Serial.println(verified_size);
+      this->failUploadLocked(507, F("SD upload verification failed"));
+      this->giveLock();
+      return;
+    }
+    this->upload.complete = true;
+  }
+  this->giveLock();
+}
+
+void SDFileServer::handleUploadRequest(AsyncWebServerRequest* request) {
+  if (!this->takeLock(portMAX_DELAY)) {
+    sendText(request, 503, F("SD card busy"), F("1"));
+    return;
+  }
+
+  if (!this->mode_active) {
+    if (this->upload.request == request)
+      this->abortUploadLocked();
+    this->giveLock();
+    sendText(request, 503, F("File manager inactive"));
+    return;
+  }
+  if (!this->authorizedLocked(request)) {
+    if (this->upload.request == request)
+      this->abortUploadLocked();
+    this->giveLock();
+    sendText(request, 403, F("Invalid request host or session token"));
+    return;
+  }
+  if (this->upload.request != request) {
+    const bool busy = this->mutation_in_progress || this->active_transfers > 0;
+    this->giveLock();
+    sendText(request, busy ? 423 : 400,
+             busy ? String(F("Another SD transfer is active")) : String(F("No upload file received")),
+             busy ? String(F("1")) : String());
+    return;
+  }
+
+  if (this->upload.error_code != 0) {
+    const int code = this->upload.error_code;
+    const String message = this->upload.error_message;
+    this->clearUploadLocked(true);
+    this->giveLock();
+    sendText(request, code, message);
+    return;
+  }
+  if (!this->upload.saw_file || !this->upload.complete || this->upload.temp_path.length() == 0) {
+    this->clearUploadLocked(true);
+    this->giveLock();
+    sendText(request, 400, F("Upload did not complete"));
+    return;
+  }
+
+  const String target_path = this->upload.target_path;
+  const String temp_path = this->upload.temp_path;
+  const bool target_exists = SD.exists(target_path);
+  bool replaced = false;
+  bool committed = false;
+  bool backup_cleanup_failed = false;
+  String failure_message;
+
+  if (target_exists) {
+    File existing = SD.open(target_path, FILE_READ);
+    const bool inspected = static_cast<bool>(existing);
+    const bool is_directory = inspected && existing.isDirectory();
+    if (existing)
+      existing.close();
+    if (!inspected) {
+      failure_message = F("Could not inspect the existing path");
+    }
+    else if (is_directory) {
+      failure_message = F("A directory already uses that name");
+    }
+    else if (!this->upload.overwrite) {
+      failure_message = F("File exists; enable Replace and confirm");
+    }
+    else {
+      String backup_path;
+      const String parent = parentPath(target_path);
+      if (!this->createInternalPathLocked(parent, "MB", ".BAK", backup_path)) {
+        failure_message = F("Could not reserve a backup name");
+      }
+      else if (!SD.rename(target_path.c_str(), backup_path.c_str())) {
+        failure_message = F("Could not preserve the existing file");
+      }
+      else if (!SD.rename(temp_path.c_str(), target_path.c_str())) {
+        const bool rolled_back = SD.rename(backup_path.c_str(), target_path.c_str());
+        failure_message = rolled_back
+          ? String(F("Replace failed; original file restored"))
+          : String(F("Replace failed; original retained as internal backup"));
+        if (!rolled_back)
+          Serial.println(String(F("SD file manager recovery backup: ")) + backup_path);
+      }
+      else {
+        committed = true;
+        replaced = true;
+        this->upload.temp_path = "";
+        if (!SD.remove(backup_path.c_str())) {
+          backup_cleanup_failed = true;
+          Serial.println(String(F("SD file manager stale backup: ")) + backup_path);
+        }
+      }
+    }
+  }
+  else if (SD.rename(temp_path.c_str(), target_path.c_str())) {
+    committed = true;
+    this->upload.temp_path = "";
+  }
+  else {
+    failure_message = F("Could not commit uploaded file");
+  }
+
+  if (!committed) {
+    this->clearUploadLocked(true);
+    this->giveLock();
+    sendText(request, failure_message.startsWith("File exists") ? 409 : 500, failure_message);
+    return;
+  }
+
+  const String success_message = backup_cleanup_failed
+    ? String(F("File replaced; an internal recovery backup remains"))
+    : (replaced ? String(F("File replaced")) : String(F("File uploaded")));
+  this->clearUploadLocked(false);
+  this->giveLock();
+  sendText(request, replaced ? 200 : 201, success_message);
+}
+
+void SDFileServer::handleDelete(AsyncWebServerRequest* request) {
+  if (!request->hasParam("path", true) || !request->hasParam("confirm", true)) {
+    sendText(request, 400, F("Missing delete confirmation"));
+    return;
+  }
+
+  String canonical;
+  String confirmed;
+  if (!canonicalizePath(request->getParam("path", true)->value(), false, canonical) ||
+      !canonicalizePath(request->getParam("confirm", true)->value(), false, confirmed) ||
+      canonical != confirmed) {
+    sendText(request, 400, F("Invalid or mismatched delete path"));
+    return;
+  }
+
+  if (!this->takeLock()) {
+    sendText(request, 503, F("SD card busy"), F("1"));
+    return;
+  }
+  if (!this->mode_active) {
+    this->giveLock();
+    sendText(request, 404, F("File manager inactive"));
+    return;
+  }
+  if (!this->authorizedLocked(request)) {
+    this->giveLock();
+    sendText(request, 403, F("Invalid request host or session token"));
+    return;
+  }
+  if (this->mutation_in_progress || this->active_transfers > 0) {
+    this->giveLock();
+    sendText(request, 423, F("Another SD transfer is active"), F("1"));
+    return;
+  }
+  if (!this->pathInsideShareLocked(canonical)) {
+    this->giveLock();
+    sendText(request, 403, F("Path is outside the shared directory"));
+    return;
+  }
+
+  File target = SD.open(canonical, FILE_READ);
+  if (!target) {
+    this->giveLock();
+    sendText(request, 404, F("File not found"));
+    return;
+  }
+  if (target.isDirectory()) {
+    target.close();
+    this->giveLock();
+    sendText(request, 403, F("Directory deletion is not supported"));
+    return;
+  }
+  target.close();
+
+  this->mutation_in_progress = true;
+  const bool removed = SD.remove(canonical.c_str());
+  this->mutation_in_progress = false;
+  this->giveLock();
+  sendText(request, removed ? 200 : 500,
+           removed ? String(F("File deleted")) : String(F("Could not delete file")));
+}
