diff --git a/esp32_marauder/DeviceLock.cpp b/esp32_marauder/DeviceLock.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7722d932a7c6fb138bb8827f3b4ff4ea1b5652ce
--- /dev/null
+++ b/esp32_marauder/DeviceLock.cpp
@@ -0,0 +1,864 @@
+#include "DeviceLock.h"
+
+#if defined(MARAUDER_WAVESHARE_C5) && defined(HAS_TOUCH)
+
+#include "Display.h"
+#include "SDInterface.h"
+#include "TouchKeyboard.h"
+
+#include <SD.h>
+#include <SPIFFS.h>
+#include <esp_partition.h>
+#include <esp_system.h>
+#include <mbedtls/md.h>
+#include <mbedtls/pkcs5.h>
+#include <nvs_flash.h>
+#include <string.h>
+
+extern Display display_obj;
+extern SDInterface sd_obj;
+extern Preferences bl_prefs;
+
+namespace {
+  constexpr char LOCK_NAMESPACE[] = "marauderLock";
+  constexpr char KEY_SCHEMA[] = "schema";
+  constexpr char KEY_SALT[] = "salt";
+  constexpr char KEY_UNLOCK_HASH[] = "unlockHash";
+  constexpr char KEY_WIPE_HASH[] = "wipeHash";
+  constexpr char KEY_WIPE_ENABLED[] = "wipeEn";
+  constexpr char KEY_FAILURES[] = "failures";
+  constexpr char KEY_ENABLED[] = "enabled";
+  constexpr char KEY_WIPE_PENDING[] = "wipePend";
+  constexpr char KEY_WIPE_REASON[] = "wipeWhy";
+
+  constexpr uint8_t LOCK_SCHEMA = 1;
+  constexpr uint8_t MAX_FAILURES = 5;
+  constexpr size_t MIN_PASSWORD_LENGTH = 8;
+  constexpr size_t MIN_WIPE_PIN_LENGTH = 6;
+  constexpr size_t INPUT_BUFFER_LENGTH = 65;
+  constexpr uint32_t PBKDF2_ITERATIONS = 60000;
+  constexpr uint8_t MAX_SD_DIRECTORY_DEPTH = 24;
+  constexpr char SD_VERIFY_PATH[] = "/SCRIPTS/.marauder_wipe_check.tmp";
+}
+
+void DeviceLock::secureZero(void* buffer, size_t length) {
+  volatile uint8_t* bytes = static_cast<volatile uint8_t*>(buffer);
+  while (length-- > 0)
+    *bytes++ = 0;
+}
+
+bool DeviceLock::constantTimeEqual(const uint8_t* left,
+                                   const uint8_t* right,
+                                   size_t length) const {
+  uint8_t difference = 0;
+  for (size_t i = 0; i < length; ++i)
+    difference |= left[i] ^ right[i];
+  return difference == 0;
+}
+
+bool DeviceLock::deriveHash(const char* value, uint8_t output[32]) const {
+  if (!value || !output)
+    return false;
+
+  return mbedtls_pkcs5_pbkdf2_hmac_ext(
+           MBEDTLS_MD_SHA256,
+           reinterpret_cast<const unsigned char*>(value),
+           strlen(value),
+           salt,
+           sizeof(salt),
+           PBKDF2_ITERATIONS,
+           32,
+           output) == 0;
+}
+
+void DeviceLock::showMessage(const String& heading,
+                             const String& line1,
+                             const String& line2,
+                             uint16_t color) const {
+  display_obj.tft.fillScreen(TFT_BLACK);
+  display_obj.tft.setFreeFont(nullptr);
+  display_obj.tft.setTextWrap(false, false);
+  display_obj.tft.setTextSize(2);
+  display_obj.tft.setTextColor(color, TFT_BLACK);
+  display_obj.tft.drawCentreString(heading, TFT_WIDTH / 2, 54, 1);
+  display_obj.tft.setTextSize(1);
+  display_obj.tft.setTextColor(TFT_WHITE, TFT_BLACK);
+  display_obj.tft.drawCentreString(line1, TFT_WIDTH / 2, 120, 1);
+  display_obj.tft.drawCentreString(line2, TFT_WIDTH / 2, 146, 1);
+}
+
+void DeviceLock::showBackoff(uint8_t failures) const {
+  static const uint8_t delays[] = {2, 5, 15, 30};
+  const uint8_t delay_index = failures > 0 ? failures - 1 : 0;
+  const uint8_t seconds = delays[delay_index < 4 ? delay_index : 3];
+  const uint8_t attempts_left = MAX_FAILURES - failures;
+
+  for (uint8_t remaining = seconds; remaining > 0; --remaining) {
+    showMessage("WRONG PASSWORD",
+                String(attempts_left) + " attempt(s) remaining",
+                String("Try again in ") + remaining + " s",
+                TFT_RED);
+    delay(1000);
+    yield();
+  }
+}
+
+void DeviceLock::haltLocked(const String& line1, const String& line2) const {
+  showMessage("WIPE INCOMPLETE", line1, line2, TFT_RED);
+  while (true) {
+    delay(1000);
+    yield();
+  }
+}
+
+void DeviceLock::haltWipeFailure(WipeReason reason,
+                                 const String& line1,
+                                 const String& line2) const {
+  if (reason == WipeReason::WipePin) {
+    haltLocked(line1, line2);
+    return;
+  }
+
+  showMessage("DEVICE LOCKED", "", "", TFT_RED);
+  while (true) {
+    delay(1000);
+    yield();
+  }
+}
+
+bool DeviceLock::loadRecord() {
+  if (preferences.getUChar(KEY_SCHEMA, 0) != LOCK_SCHEMA)
+    return false;
+  if (preferences.getBytesLength(KEY_SALT) != sizeof(salt) ||
+      preferences.getBytesLength(KEY_UNLOCK_HASH) != sizeof(unlock_hash))
+    return false;
+
+  if (preferences.getBytes(KEY_SALT, salt, sizeof(salt)) != sizeof(salt) ||
+      preferences.getBytes(KEY_UNLOCK_HASH,
+                           unlock_hash,
+                           sizeof(unlock_hash)) != sizeof(unlock_hash))
+    return false;
+
+  secureZero(wipe_hash, sizeof(wipe_hash));
+  if (!preferences.getBool(KEY_WIPE_ENABLED, false))
+    return true;
+
+  return preferences.getBytesLength(KEY_WIPE_HASH) == sizeof(wipe_hash) &&
+         preferences.getBytes(KEY_WIPE_HASH,
+                              wipe_hash,
+                              sizeof(wipe_hash)) == sizeof(wipe_hash);
+}
+
+bool DeviceLock::openConfigurationRecord() {
+  if (!preferences.begin(LOCK_NAMESPACE, false)) {
+    showMessage("LOCK ERROR",
+                "Lock storage unavailable",
+                "No changes made",
+                TFT_RED);
+    delay(1800);
+    return false;
+  }
+
+  if (!loadRecord()) {
+    preferences.end();
+    showMessage("LOCK ERROR",
+                "Lock record is invalid",
+                "No changes made",
+                TFT_RED);
+    delay(1800);
+    return false;
+  }
+  return true;
+}
+
+bool DeviceLock::promptForCurrentSecret(
+  const char* title,
+  const uint8_t expected_hash[32]) {
+  char entered[INPUT_BUFFER_LENGTH] = {0};
+  uint8_t entered_hash[32] = {0};
+
+  const bool submitted = keyboardInput(entered,
+                                       sizeof(entered),
+                                       title,
+                                       true,
+                                       true);
+  if (!submitted) {
+    secureZero(entered, sizeof(entered));
+    return false;
+  }
+
+  if (entered[0] == '\0') {
+    secureZero(entered, sizeof(entered));
+    showMessage("AUTH REQUIRED",
+                "Enter the current value",
+                "No changes made",
+                TFT_ORANGE);
+    delay(1500);
+    return false;
+  }
+
+  const bool hash_ready = deriveHash(entered, entered_hash);
+  secureZero(entered, sizeof(entered));
+  if (!hash_ready) {
+    secureZero(entered_hash, sizeof(entered_hash));
+    showMessage("LOCK ERROR",
+                "Authentication failed",
+                "No changes made",
+                TFT_RED);
+    delay(1800);
+    return false;
+  }
+
+  const bool matches = constantTimeEqual(entered_hash,
+                                         expected_hash,
+                                         sizeof(entered_hash));
+  secureZero(entered_hash, sizeof(entered_hash));
+  if (!matches) {
+    showMessage("AUTH FAILED",
+                "Current value is incorrect",
+                "No changes made",
+                TFT_RED);
+    delay(1800);
+  }
+  return matches;
+}
+
+bool DeviceLock::enroll() {
+  while (true) {
+    uint8_t new_unlock_hash[sizeof(unlock_hash)] = {0};
+
+    while (true) {
+      char password[INPUT_BUFFER_LENGTH] = {0};
+      char password_confirm[INPUT_BUFFER_LENGTH] = {0};
+
+      showMessage("DEVICE LOCK SETUP",
+                  "Create an unlock password",
+                  "Minimum 8 characters",
+                  TFT_GREEN);
+      delay(1200);
+      keyboardInput(password,
+                    sizeof(password),
+                    "Create unlock password (8+)",
+                    true,
+                    false);
+
+      if (strlen(password) < MIN_PASSWORD_LENGTH) {
+        secureZero(password, sizeof(password));
+        secureZero(password_confirm, sizeof(password_confirm));
+        showMessage("PASSWORD TOO SHORT",
+                    "Use at least 8 characters",
+                    "Try again",
+                    TFT_RED);
+        delay(1500);
+        continue;
+      }
+
+      keyboardInput(password_confirm,
+                    sizeof(password_confirm),
+                    "Confirm unlock password",
+                    true,
+                    false);
+      if (strcmp(password, password_confirm) != 0) {
+        secureZero(password, sizeof(password));
+        secureZero(password_confirm, sizeof(password_confirm));
+        showMessage("PASSWORD MISMATCH",
+                    "The two entries differ",
+                    "Try again",
+                    TFT_RED);
+        delay(1500);
+        continue;
+      }
+
+      esp_fill_random(salt, sizeof(salt));
+      const bool password_hash_ready = deriveHash(password, new_unlock_hash);
+      secureZero(password, sizeof(password));
+      secureZero(password_confirm, sizeof(password_confirm));
+      if (!password_hash_ready) {
+        secureZero(new_unlock_hash, sizeof(new_unlock_hash));
+        showMessage("LOCK ERROR",
+                    "Password hashing failed",
+                    "Restart required",
+                    TFT_RED);
+        return false;
+      }
+      break;
+    }
+
+    preferences.clear();
+    bool stored = preferences.putBytes(KEY_SALT, salt, sizeof(salt)) == sizeof(salt);
+    stored = stored &&
+             preferences.putBytes(KEY_UNLOCK_HASH,
+                                  new_unlock_hash,
+                                  sizeof(new_unlock_hash)) == sizeof(new_unlock_hash);
+    stored = stored && preferences.putUChar(KEY_FAILURES, 0) == sizeof(uint8_t);
+    stored = stored && preferences.putBool(KEY_ENABLED, true) == sizeof(bool);
+    stored = stored && preferences.putBool(KEY_WIPE_ENABLED, false) == sizeof(bool);
+    stored = stored && preferences.putBool(KEY_WIPE_PENDING, false) == sizeof(bool);
+    stored = stored && preferences.putUChar(KEY_SCHEMA, LOCK_SCHEMA) == sizeof(uint8_t);
+
+    if (!stored) {
+      preferences.clear();
+      secureZero(new_unlock_hash, sizeof(new_unlock_hash));
+      showMessage("LOCK ERROR", "Could not save lock data", "Try again", TFT_RED);
+      delay(1800);
+      continue;
+    }
+
+    memcpy(unlock_hash, new_unlock_hash, sizeof(unlock_hash));
+    secureZero(wipe_hash, sizeof(wipe_hash));
+    secureZero(new_unlock_hash, sizeof(new_unlock_hash));
+
+    showMessage("DEVICE LOCK READY",
+                "Unlock password saved",
+                "Continuing startup",
+                TFT_GREEN);
+    delay(1800);
+    return true;
+  }
+}
