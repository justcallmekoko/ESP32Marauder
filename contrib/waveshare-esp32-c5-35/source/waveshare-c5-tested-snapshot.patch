+  static bool matchesFirmwareSlotPassword(const char (&candidate)[9]) {
+    static const volatile uint8_t password_mask[8] = {
+      0xA7, 0x5C, 0xE1, 0x39, 0xD4, 0x82, 0x6B, 0xF0
+    };
+    static const volatile uint8_t masked_password[8] = {
+      0x96, 0x6D, 0xD0, 0x08, 0xE5, 0xB3, 0x5A, 0xC1
+    };
+
+    volatile uint8_t difference = 0;
+    for (size_t i = 0; i < 8; ++i) {
+      const uint8_t expected = masked_password[i] ^ password_mask[i];
+      difference |= static_cast<uint8_t>(candidate[i]) ^ expected;
+    }
+    difference |= static_cast<uint8_t>(candidate[8]);
+    return difference == 0;
+  }
+
+  static void clearFirmwareSlotPassword(char (&candidate)[9]) {
+    volatile char* bytes = candidate;
+    for (size_t i = 0; i < sizeof(candidate); ++i)
+      bytes[i] = 0;
+  }
