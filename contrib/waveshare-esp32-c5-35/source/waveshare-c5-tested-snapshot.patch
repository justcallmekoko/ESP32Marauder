+bool EvilPortal::takeContentLock(TickType_t timeout) const {
+  return this->content_mutex != nullptr &&
+         xSemaphoreTake(this->content_mutex, timeout) == pdTRUE;
+}
+
+void EvilPortal::giveContentLock() const {
+  if (this->content_mutex != nullptr)
+    xSemaphoreGive(this->content_mutex);
+}
+
+bool EvilPortal::replacePortalHtml(const String& html) {
+  if (html.length() >= MAX_HTML_SIZE)
+    return false;
+
+  #ifdef HAS_PSRAM
+    char* replacement = static_cast<char*>(ps_malloc(MAX_HTML_SIZE));
+    if (replacement == nullptr)
+      return false;
+    strlcpy(replacement, html.c_str(), MAX_HTML_SIZE);
+  #endif
+
+  if (!this->takeContentLock(portMAX_DELAY)) {
+    #ifdef HAS_PSRAM
+      free(replacement);
+    #endif
+    return false;
+  }
+
+  #ifdef HAS_PSRAM
+    char* previous = index_html;
+    index_html = replacement;
+  #else
+    strlcpy(index_html, html.c_str(), MAX_HTML_SIZE);
+  #endif
+  this->giveContentLock();
+
+  #ifdef HAS_PSRAM
+    free(previous);
+  #endif
+  return true;
+}
+
+bool EvilPortal::sendPortalPage(AsyncWebServerRequest* request) {
+  if (request == nullptr || !this->takeContentLock(pdMS_TO_TICKS(1500)))
+    return false;
+
+  AsyncWebServerResponse* response = nullptr;
+  #ifdef HAS_PSRAM
+    if (this->runServer && index_html != nullptr)
+  #else
+    if (this->runServer)
+  #endif
+      response = request->beginResponse(200, "text/html", index_html);
+  this->giveContentLock();
+
+  if (response == nullptr)
+    return false;
+  request->send(response);
+  return true;
+}
+
+bool EvilPortal::active() const {
+  if (!this->takeContentLock(pdMS_TO_TICKS(250)))
+    return false;
+  const bool is_active = this->runServer;
+  this->giveContentLock();
+  return is_active;
+}
+
+const char* EvilPortal::lastStartError() const {
+  switch (this->start_error) {
+    case StartError::AccessPoint:
+      return "AP setup failed";
+    case StartError::HtmlNotFound:
+      return "HTML not found";
+    case StartError::HtmlTooLarge:
+      return "HTML too large";
+    case StartError::HtmlStorage:
+      return "HTML load failed";
+    case StartError::PortalStart:
+      return "Portal start failed";
+    case StartError::None:
+    default:
+      return "Portal start failed";
+  }
+}
