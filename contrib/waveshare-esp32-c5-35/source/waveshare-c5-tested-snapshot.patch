+class SDFileServer::DownloadReleaseGuard {
+  public:
+    DownloadReleaseGuard(SDFileServer* owner, AsyncWebServerRequest* request)
+      : owner(owner), request(request) {}
+    ~DownloadReleaseGuard() {
+      if (this->owner != nullptr)
+        this->owner->handleDownloadComplete(this->request);
+    }
+
+  private:
+    SDFileServer* owner;
+    AsyncWebServerRequest* request;
+};
