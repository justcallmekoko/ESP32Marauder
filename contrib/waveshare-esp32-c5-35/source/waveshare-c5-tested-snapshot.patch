+constexpr const char* CSRF_HEADER = "X-Marauder-CSRF";
+constexpr const char* LEGACY_INTERNAL_PREFIX = ".marauder-";
+constexpr const char* LEGACY_METADATA_DIRECTORY = "/.marauder-system";
+constexpr const char* RESERVED_METADATA_DIRECTORY = "mrdsys01";
+constexpr const char* FILE_SERVER_HOST = "192.168.4.1";
