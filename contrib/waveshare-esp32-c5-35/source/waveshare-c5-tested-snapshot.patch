+bool DeviceLock::wipeSDDirectory(const String& path, uint8_t depth) {
+  if (depth > MAX_SD_DIRECTORY_DEPTH)
+    return false;
+
+  // Reopen the directory for every entry. This avoids keeping a FAT directory
+  // iterator open while the entry it points at is removed.
+  while (true) {
+    File directory = SD.open(path.c_str(), FILE_READ);
+    if (!directory || !directory.isDirectory()) {
+      if (directory)
+        directory.close();
+      return false;
+    }
+
+    File entry = directory.openNextFile();
+    if (!entry) {
+      directory.close();
+      return true;
+    }
+
+    String child_path = entry.path();
+    if (child_path.length() == 0) {
+      child_path = path;
+      if (!child_path.endsWith("/"))
+        child_path += '/';
+      child_path += entry.name();
+    }
+    const bool is_directory = entry.isDirectory();
+    entry.close();
+    directory.close();
+
+    if (child_path.length() == 0 || child_path == "/" || child_path == path) {
+      return false;
+    }
+
+    bool removed = false;
+    if (is_directory) {
+      removed = wipeSDDirectory(child_path, depth + 1) &&
+                SD.rmdir(child_path.c_str());
+    }
+    else {
+      removed = SD.remove(child_path.c_str());
+    }
+
+    if (!removed) {
+      return false;
+    }
+
+    yield();
+  }
+}
+
+bool DeviceLock::verifySDCardWritable() {
+  static const uint8_t expected[] = {0x4d, 0x41, 0x52, 0x41, 0x55, 0x44, 0x45, 0x52};
+  uint8_t actual[sizeof(expected)] = {0};
+
+  SD.remove(SD_VERIFY_PATH);
+  File probe = SD.open(SD_VERIFY_PATH, FILE_WRITE);
+  if (!probe)
+    return false;
+  bool write_ok = probe.write(expected, sizeof(expected)) == sizeof(expected);
+  probe.flush();
+  write_ok = write_ok && probe.getWriteError() == 0;
+  probe.close();
+  if (!write_ok) {
+    SD.remove(SD_VERIFY_PATH);
+    return false;
+  }
+
+  probe = SD.open(SD_VERIFY_PATH, FILE_READ);
+  if (!probe) {
+    SD.remove(SD_VERIFY_PATH);
+    return false;
+  }
+  const bool read_ok = probe.read(actual, sizeof(actual)) == sizeof(actual);
+  probe.close();
+
+  const bool content_ok = read_ok &&
+                          constantTimeEqual(expected, actual, sizeof(expected));
+  secureZero(actual, sizeof(actual));
+  const bool remove_ok = SD.remove(SD_VERIFY_PATH);
+  return content_ok && remove_ok;
+}
+
+bool DeviceLock::wipeSDCard() {
+  if (!sd_obj.initSD() || !sd_obj.supported) {
+    SD.end();
+    sd_obj.supported = false;
+    return false;
+  }
+
+  bool success = wipeSDDirectory("/", 0);
+  if (success)
+    success = SD.mkdir("/SCRIPTS") || SD.exists("/SCRIPTS");
+  if (success)
+    success = verifySDCardWritable();
+
+  SD.end();
+  sd_obj.supported = false;
+  return success;
+}
+
+bool DeviceLock::eraseCoredump() {
+  const esp_partition_t* coredump = esp_partition_find_first(
+    ESP_PARTITION_TYPE_DATA,
+    ESP_PARTITION_SUBTYPE_DATA_COREDUMP,
+    nullptr);
+  if (!coredump)
+    return true;
+  return esp_partition_erase_range(coredump, 0, coredump->size) == ESP_OK;
+}
+
+bool DeviceLock::wipeUserData(WipeReason reason) {
+  const bool discreet = reason == WipeReason::TooManyFailures;
+  if (discreet)
+    showMessage("DEVICE LOCKED", "", "", TFT_RED);
+  else
+    showMessage("DATA WIPE",
+                "Deleting SD files safely",
+                "Do not remove power",
+                TFT_ORANGE);
+  if (!wipeSDCard())
+    haltWipeFailure(reason,
+                    "SD wipe or health check failed",
+                    "Fix card and reboot to retry");
+
+  if (!discreet)
+    showMessage("DATA WIPE",
+                "Clearing internal user data",
+                "Do not remove power",
+                TFT_ORANGE);
+  SPIFFS.end();
+  if (!SPIFFS.format())
+    haltWipeFailure(reason, "SPIFFS wipe failed", "Reboot to retry");
+  if (!eraseCoredump())
+    haltWipeFailure(reason, "Coredump wipe failed", "Reboot to retry");
+
+  bl_prefs.end();
+  nvs_flash_deinit();
+  if (nvs_flash_erase() != ESP_OK)
+    haltWipeFailure(reason, "NVS wipe failed", "Device remains locked");
+
+  if (discreet) {
+    showMessage("DEVICE LOCKED", "", "", TFT_RED);
+    delay(800);
+  }
+  else {
+    showMessage("WIPE COMPLETE",
+                "SD and all user data cleared",
+                "Restarting into setup",
+                TFT_GREEN);
+    delay(2200);
+  }
+  ESP.restart();
+
+  while (true)
+    delay(1000);
+  return false;
+}
+
+bool DeviceLock::triggerWipe(WipeReason reason) {
+  const bool pending_saved =
+    preferences.putUChar(KEY_WIPE_REASON, static_cast<uint8_t>(reason)) == sizeof(uint8_t) &&
+    preferences.putBool(KEY_WIPE_PENDING, true) == sizeof(bool);
+  if (!pending_saved)
+    haltLocked("Could not arm data wipe", "Device remains locked");
+
+  #ifdef MARAUDER_DEVICE_LOCK_WIPE_DRY_RUN
+    preferences.putBool(KEY_WIPE_PENDING, false);
+    preferences.putUChar(KEY_FAILURES, 0);
+    showMessage("WIPE TEST TRIGGERED",
+                reason == WipeReason::WipePin ? "WIPE PIN recognized" : "Five failures recognized",
+                "Dry run: no data deleted",
+                TFT_ORANGE);
+    delay(2600);
+    return true;
+  #else
+    preferences.end();
+    return wipeUserData(reason);
+  #endif
+}
+
+bool DeviceLock::enforce() {
+  if (!preferences.begin(LOCK_NAMESPACE, false)) {
+    haltLocked("Lock storage unavailable", "Restart required");
+    return false;
+  }
+
+  if (preferences.getBool(KEY_WIPE_PENDING, false)) {
+    WipeReason pending_reason = static_cast<WipeReason>(
+      preferences.getUChar(KEY_WIPE_REASON,
+                           static_cast<uint8_t>(WipeReason::TooManyFailures)));
+    if (!triggerWipe(pending_reason))
+      return false;
+  }
+
+  const uint8_t schema = preferences.getUChar(KEY_SCHEMA, 0);
+  if (schema == 0) {
+    if (!enroll())
+      return false;
+    preferences.end();
+    return true;
+  }
+  if (schema != LOCK_SCHEMA || !loadRecord()) {
+    haltLocked("Lock record is invalid", "Erase NVS to recover");
+    return false;
+  }
+
+  if (!preferences.getBool(KEY_ENABLED, true)) {
+    preferences.putUChar(KEY_FAILURES, 0);
+    preferences.end();
+    return true;
+  }
+
+  uint8_t failures = preferences.getUChar(KEY_FAILURES, 0);
+  const bool wipe_pin_enabled = preferences.getBool(KEY_WIPE_ENABLED, false);
+  if (failures >= MAX_FAILURES) {
+    if (!triggerWipe(WipeReason::TooManyFailures))
+      return false;
+    failures = 0;
+  }
+
+  while (true) {
+    char entered[INPUT_BUFFER_LENGTH] = {0};
+    uint8_t entered_hash[sizeof(unlock_hash)] = {0};
+    const String title = String("Unlock - ") +
+                         (MAX_FAILURES - failures) +
+                         " attempt(s) left";
+
+    keyboardInput(entered,
+                  sizeof(entered),
+                  title.c_str(),
+                  true,
+                  false);
+
+    if (entered[0] == '\0') {
+      showMessage("INPUT REQUIRED", "Enter password", "Empty input is not counted", TFT_ORANGE);
+      delay(1200);
+      continue;
+    }
+
+    if (!deriveHash(entered, entered_hash)) {
+      secureZero(entered, sizeof(entered));
+      secureZero(entered_hash, sizeof(entered_hash));
+      haltLocked("Password hashing failed", "Restart required");
+      return false;
+    }
+
+    const bool is_wipe_pin = wipe_pin_enabled &&
+                             constantTimeEqual(entered_hash,
+                                               wipe_hash,
+                                               sizeof(wipe_hash));
+    const bool is_unlock_password = constantTimeEqual(entered_hash,
+                                                      unlock_hash,
+                                                      sizeof(unlock_hash));
+    secureZero(entered, sizeof(entered));
+    secureZero(entered_hash, sizeof(entered_hash));
+
+    if (is_wipe_pin) {
+      if (!triggerWipe(WipeReason::WipePin))
+        return false;
+      failures = 0;
+      continue;
+    }
+
+    if (is_unlock_password) {
+      preferences.putUChar(KEY_FAILURES, 0);
+      preferences.end();
+      showMessage("DEVICE UNLOCKED", "Password accepted", "Continuing startup", TFT_GREEN);
+      delay(900);
+      return true;
+    }
+
+    failures++;
+    if (preferences.putUChar(KEY_FAILURES, failures) != sizeof(uint8_t))
+      haltLocked("Could not save failure count", "Device remains locked");
+    if (failures >= MAX_FAILURES) {
+      if (!triggerWipe(WipeReason::TooManyFailures))
+        return false;
+      failures = 0;
+      continue;
+    }
+
+    showBackoff(failures);
+  }
+}
+
