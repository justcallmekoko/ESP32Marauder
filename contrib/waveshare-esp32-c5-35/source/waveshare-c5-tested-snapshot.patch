+// Base classes are destroyed in reverse declaration order: AsyncFileResponse
+// closes its File before DownloadReleaseGuard releases the transfer lock.
+class SDFileServer::TrackedFileResponse
+  : private DownloadReleaseGuard, public AsyncFileResponse {
+  public:
+    TrackedFileResponse(
+      SDFileServer* owner,
+      AsyncWebServerRequest* request,
+      ::fs::File file,
+      const String& path)
+      : DownloadReleaseGuard(owner, request),
+        AsyncFileResponse(file, path, "application/octet-stream", true) {}
+    ~TrackedFileResponse() override = default;
+};
