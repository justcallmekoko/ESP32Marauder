+static bool isHiddenAccessPoint(const AccessPoint& ap) {
+  return !ap.essid.length() || ap.essid.equalsIgnoreCase(macToString(ap.bssid));
+}
+
+static String formatAPMenuLabel(const AccessPoint& ap) {
+  const String bssid = macToString(ap.bssid);
+  const bool hidden = isHiddenAccessPoint(ap);
+
+  String label = F("[CH ");
+  label += ap.channel;
+  label += F("] ");
+
+  #if defined(MARAUDER_WAVESHARE_C5) && defined(HAS_320X480_SCREEN)
+    constexpr size_t MAX_C5_AP_LABEL_CHARS = 27;
+    if (hidden)
+      return label + F("<hid> ") + bssid;
+
+    if (label.length() + ap.essid.length() <= MAX_C5_AP_LABEL_CHARS)
+      return label + ap.essid;
+
+    const size_t ssid_budget =
+      label.length() < MAX_C5_AP_LABEL_CHARS
+        ? MAX_C5_AP_LABEL_CHARS - label.length()
+        : 0;
+    String visible_ssid = ap.essid;
+    if (visible_ssid.length() > ssid_budget) {
+      if (ssid_budget > 3) {
+        visible_ssid.remove(ssid_budget - 3);
+        visible_ssid += F("...");
+      }
+      else {
+        visible_ssid.remove(ssid_budget);
+      }
+    }
+    return label + visible_ssid;
+  #endif
+
+  if (hidden) {
+    label += F("<hidden> MAC: ");
+    label += bssid;
+  }
+  else {
+    label += ap.essid;
+  }
+  return label;
+}
