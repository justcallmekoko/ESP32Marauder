+  }
+
+  while (true) {
+    File entry = dir.openNextFile();
+    if (!entry)
+      break;
+
+    if (entry.isDirectory()) {
+      entry.close();
+      continue;
+    }
+
+    const String file_name = entry.name();
+    String base_name = file_name;
+    while (base_name.startsWith("/"))
+      base_name.remove(0, 1);
+
+    String normalized_name = base_name;
+    String normalized_extension = ext;
+    normalized_name.toLowerCase();
+    normalized_extension.toLowerCase();
+    const bool matches_extension =
+      !ext.length() || normalized_name.endsWith(normalized_extension);
+    const bool matches_prefix = !prefix.length() || base_name.startsWith(prefix);
+    if (!matches_extension || !matches_prefix) {
+      entry.close();
+      continue;
     }
+
+    if ((max_results != 0) &&
+        (static_cast<size_t>(file_names->size()) >= max_results)) {
+      if (truncated != nullptr)
+        *truncated = true;
+      entry.close();
+      continue;
+    }
+
+    // CustomLinkedList::add() cannot report allocation failure. Keep a
+    // conservative reserve so a large SD root cannot exhaust the device heap.
+    if (ESP.getFreeHeap() <= 24576 || !file_names->add(file_name)) {
+      entry.close();
+      dir.close();
+      file_names->clear();
+      return false;
+    }
+    entry.close();
   }
+
+  dir.close();
