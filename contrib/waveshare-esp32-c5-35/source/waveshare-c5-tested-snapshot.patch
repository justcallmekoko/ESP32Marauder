+bool DeviceLock::changeWipePin() {
+  if (!openConfigurationRecord())
+    return false;
+
+  const bool wipe_pin_enabled = preferences.getBool(KEY_WIPE_ENABLED, false);
+  if (!promptForCurrentSecret(wipe_pin_enabled
+                               ? "Current WIPE PIN"
+                               : "Confirm unlock password",
+                              wipe_pin_enabled ? wipe_hash : unlock_hash)) {
+    preferences.end();
+    return false;
+  }
+
+  while (true) {
+    char new_wipe_pin[INPUT_BUFFER_LENGTH] = {0};
+    char confirmation[INPUT_BUFFER_LENGTH] = {0};
+    uint8_t new_hash[sizeof(wipe_hash)] = {0};
+    uint8_t stored_hash[sizeof(wipe_hash)] = {0};
+
+    if (!keyboardInput(new_wipe_pin,
+                       sizeof(new_wipe_pin),
+                       "New WIPE PIN (6+)",
+                       true,
+                       true)) {
+      secureZero(new_wipe_pin, sizeof(new_wipe_pin));
+      preferences.end();
+      return false;
+    }
+
+    if (strlen(new_wipe_pin) < MIN_WIPE_PIN_LENGTH) {
+      secureZero(new_wipe_pin, sizeof(new_wipe_pin));
+      showMessage("WIPE PIN TOO SHORT",
+                  "Use at least 6 characters",
+                  "Try again",
+                  TFT_RED);
+      delay(1500);
+      continue;
+    }
+
+    if (!keyboardInput(confirmation,
+                       sizeof(confirmation),
+                       "Confirm new WIPE PIN",
+                       true,
+                       true)) {
+      secureZero(new_wipe_pin, sizeof(new_wipe_pin));
+      secureZero(confirmation, sizeof(confirmation));
+      preferences.end();
+      return false;
+    }
+
+    if (strcmp(new_wipe_pin, confirmation) != 0) {
+      secureZero(new_wipe_pin, sizeof(new_wipe_pin));
+      secureZero(confirmation, sizeof(confirmation));
+      showMessage("WIPE PIN MISMATCH",
+                  "The two entries differ",
+                  "Try new WIPE PIN again",
+                  TFT_RED);
+      delay(1500);
+      continue;
+    }
+
+    const bool hash_ready = deriveHash(new_wipe_pin, new_hash);
+    secureZero(new_wipe_pin, sizeof(new_wipe_pin));
+    secureZero(confirmation, sizeof(confirmation));
+    if (!hash_ready) {
+      secureZero(new_hash, sizeof(new_hash));
+      preferences.end();
+      showMessage("LOCK ERROR",
+                  "Wipe PIN hashing failed",
+                  "No changes made",
+                  TFT_RED);
+      delay(1800);
+      return false;
+    }
+
+    if (constantTimeEqual(new_hash, unlock_hash, sizeof(new_hash))) {
+      secureZero(new_hash, sizeof(new_hash));
+      showMessage("WIPE PIN MUST DIFFER",
+                  "Choose a different WIPE PIN",
+                  "Unlock password is unchanged",
+                  TFT_RED);
+      delay(1800);
+      continue;
+    }
+
+    bool stored =
+      preferences.putBytes(KEY_WIPE_HASH,
+                           new_hash,
+                           sizeof(new_hash)) == sizeof(new_hash);
+    stored = stored &&
+             preferences.getBytes(KEY_WIPE_HASH,
+                                  stored_hash,
+                                  sizeof(stored_hash)) == sizeof(stored_hash) &&
+             constantTimeEqual(new_hash, stored_hash, sizeof(new_hash));
+    if (stored)
+      stored = preferences.putBool(KEY_WIPE_ENABLED, true) == sizeof(bool) &&
+               preferences.getBool(KEY_WIPE_ENABLED, false);
+    if (stored)
+      memcpy(wipe_hash, new_hash, sizeof(wipe_hash));
+
+    secureZero(new_hash, sizeof(new_hash));
+    secureZero(stored_hash, sizeof(stored_hash));
+    preferences.end();
+
+    showMessage(stored
+                  ? (wipe_pin_enabled ? "WIPE PIN UPDATED" : "WIPE PIN ENABLED")
+                  : "LOCK ERROR",
+                stored
+                  ? (wipe_pin_enabled ? "WIPE PIN changed" : "WIPE PIN is now active")
+                  : "Could not save WIPE PIN",
+                stored
+                  ? (wipe_pin_enabled ? "Previous WIPE PIN is invalid" : "Use it only to erase data")
+                  : "Restart and try again",
+                stored ? TFT_GREEN : TFT_RED);
+    delay(1800);
+    return stored;
+  }
+}
+
+bool DeviceLock::toggleEnabled() {
+  if (!openConfigurationRecord())
+    return false;
+
+  if (!promptForCurrentSecret("Confirm unlock password", unlock_hash)) {
+    preferences.end();
+    return false;
+  }
+
+  const bool enable_lock = !preferences.getBool(KEY_ENABLED, true);
+  bool stored =
+    preferences.putBool(KEY_ENABLED, enable_lock) == sizeof(bool);
+  stored = stored &&
+           preferences.getBool(KEY_ENABLED, !enable_lock) == enable_lock;
+  if (stored)
+    stored = preferences.putUChar(KEY_FAILURES, 0) == sizeof(uint8_t);
+  preferences.end();
+
+  showMessage(
+    stored
+      ? (enable_lock ? "DEVICE LOCK ENABLED" : "DEVICE LOCK DISABLED")
+      : "LOCK ERROR",
+    stored
+      ? (enable_lock ? "Password required at boot" : "Boot password disabled")
+      : "Could not save lock state",
+    stored ? "Effective after restart" : "Restart and try again",
+    stored ? (enable_lock ? TFT_GREEN : TFT_ORANGE) : TFT_RED);
+  delay(2000);
+  return stored;
+}
