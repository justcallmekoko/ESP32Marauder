+class DeviceLock {
+  public:
+    // Blocks setup until a password has been enrolled and entered correctly.
+    bool enforce();
+    bool changeUnlockPassword();
+    bool changeWipePin();
+    bool toggleEnabled();
+
+  private:
+    enum class WipeReason : uint8_t {
+      TooManyFailures = 1,
+      WipePin = 2
+    };
+
+    Preferences preferences;
+    uint8_t salt[16] = {0};
+    uint8_t unlock_hash[32] = {0};
+    uint8_t wipe_hash[32] = {0};
+
+    bool enroll();
+    bool loadRecord();
